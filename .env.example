# ========== NEON DATABASE (para Vercel/Production) ==========
# Copie a connection string do seu projeto Neon
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ========== OU USE VARIÁVEIS INDIVIDUAIS (Local/Development) ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=login_system
DB_USER=postgres
DB_PASSWORD=postgres

# ========== JWT CONFIGURATION ==========
JWT_SECRET=sua_chave_secreta_super_segura_aqui_MUDAR_EM_PRODUCAO_12345
JWT_REFRESH_SECRET=sua_chave_secreta_refresh_mudar_em_producao_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========== EMAIL CONFIGURATION (Gmail example) ==========
EMAIL_SERVICE=gmail
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_app_gmail
EMAIL_FROM=noreply@loginsystem.com

# ========== SERVER CONFIGURATION ==========
NODE_ENV=development
PORT=3000
